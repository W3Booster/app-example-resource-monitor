{
  "name": "Resource Monitor",
  "description": "Learn scoped live data with player resources, supply, and hero levels. Handles missing data explicitly and includes offline scenarios and full TypeScript source.",
  "surfaces": [
    "application"
  ],
  "applicationUrl": "http://localhost:5173/?demo=0",
  "scopes": [
    "match:read",
    "players:read",
    "resources:read",
    "heroes:read",
    "overlay:read"
  ],
  "settingsSchema": {
    "version": 1,
    "sections": [
      {
        "id": "display",
        "title": "Display",
        "groups": [
          {
            "id": "appearance",
            "title": "Appearance"
          }
        ],
        "fields": [
          {
            "key": "display.title",
            "label": "App title",
            "type": "text",
            "group": "appearance",
            "default": "My first W3Booster app"
          }
        ]
      }
    ]
  }
}
